# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/watchtogether?retryWrites=true&w=majority

# Realtime sync server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Discord Webhook for feedback and bug reports (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<webhook_id>/<webhook_token>
